  <key id="d2" for="edge" attr.name="weight" attr.type="long" />
  <key id="d1" for="node" attr.name="dc_in" attr.type="long" />
  <key id="d0" for="node" attr.name="dc_out" attr.type="long" />
  <graph edgedefault="directed">
    <node id="Satana">
      <data key="d0">1</data>
      <data key="d1">0</data>
    </node>
