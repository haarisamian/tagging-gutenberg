      <data key="d1">1</data>
    </node>
    <node id="Butler">
      <data key="d0">2</data>
      <data key="d1">0</data>
    </node>
    <edge source="Satana" target="Jesus Christ">
      <data key="d2">1</data>
    </edge>
    <edge source="COLMAN" target="God">
      <data key="d2">3</data>
